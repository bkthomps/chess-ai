+// The three ranks ahead of a king, on each adjacent file. These immutable
+// masks replace repeated square-by-square pawn-shield/storm scans.
+const fn king_pawn_lanes() -> [[[u64; 3]; 64]; 2] {
+    let mut lanes = [[[0; 3]; 64]; 2];
+    let mut color = 0;
+    while color < 2 {
+        let mut king = 0;
+        while king < 64 {
+            let mut lane = 0;
+            while lane < 3 {
+                let file = (king % 8) as i32 + lane as i32 - 1;
+                let mut distance = 1;
+                while distance <= 3 {
+                    let rank = (king / 8) as i32 + if color == 1 { distance } else { -distance };
+                    if file >= 0 && file < 8 && rank >= 0 && rank < 8 {
+                        lanes[color][king][lane] |= 1u64 << (8 * rank + file);
+                    }
+                    distance += 1;
+                }
+                lane += 1;
+            }
+            king += 1;
+        }
+        color += 1;
+    }
+    lanes
+}
+const KING_PAWN_LANES: [[[u64; 3]; 64]; 2] = king_pawn_lanes();
+
+fn nearest_pawn_distance(pawns: u64, rank: i32, color: usize) -> usize {
+    if pawns == 0 {
+        0
+    } else if color == 1 {
+        (pawns.trailing_zeros() as i32 / 8 - rank) as usize
+    } else {
+        (rank - (63 - pawns.leading_zeros()) as i32 / 8) as usize
+    }
+}
