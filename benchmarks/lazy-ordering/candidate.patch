+// Select moves only as search consumes them. Stable extraction preserves the
+// original tie order and therefore the serial search tree. Oversized lists use
+// the existing allocation-free sort instead of increasing per-ply scratch.
+struct MovePicker {
+    priorities: [i32; 64],
+    sorted: bool,
+}
+impl MovePicker {
+    fn new(moves: &mut [Move], priority: impl Fn(Move) -> i32) -> Self {
+        let mut picker = Self {
+            priorities: [0; 64],
+            sorted: moves.len() > 64,
+        };
+        if picker.sorted {
+            sort_moves(moves, priority);
+        } else {
+            for (score, &m) in picker.priorities.iter_mut().zip(moves.iter()) {
+                *score = priority(m);
+            }
+        }
+        picker
+    }
+    fn next(&mut self, moves: &mut [Move], index: usize) -> Move {
+        if !self.sorted && index != 0 {
+            // Most cutoffs use the first move. Once it fails, insertion sort
+            // handles the remaining (often already similar-priority) moves.
+            for current in index + 1..moves.len() {
+                let m = moves[current];
+                let score = self.priorities[current];
+                let mut target = current;
+                while target > index && self.priorities[target - 1] < score {
+                    moves[target] = moves[target - 1];
+                    self.priorities[target] = self.priorities[target - 1];
+                    target -= 1;
+                }
+                moves[target] = m;
+                self.priorities[target] = score;
+            }
+            self.sorted = true;
+        }
+        if !self.sorted {
+            let mut best = index;
+            for candidate in index + 1..moves.len() {
+                if self.priorities[candidate] > self.priorities[best] {
+                    best = candidate;
+                }
+            }
+            moves[index..=best].rotate_right(1);
+            self.priorities[index..=best].rotate_right(1);
+        }
+        moves[index]
+    }
+}
